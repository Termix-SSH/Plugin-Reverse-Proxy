{
  "id": "reverse-proxy",
  "name": "Reverse Proxy",
  "version": "1.2.0",
  "description": "Reverse proxy for TCP, UDP, HTTP and HTTPS with free certificates and Termix login, managed per host.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Reverse-Proxy",
  "docs": "https://docs.termix.site/plugins/reverse-proxy",
  "video": "https://www.youtube.com/watch?v=yvk_JjcTKsM",
  "category": "Networking",
  "icon": "Waypoints",
  "features": [
    "TCP, UDP, HTTP and HTTPS routes for each host, with status, search and filters",
    "Free Let's Encrypt certificates that renew on their own, plus self-signed and uploaded certificates",
    "Optional Termix login in front of any web route",
    "WebSocket support, forced HTTPS, custom headers and IP allow and deny lists",
    "One overview of every route, its status and its certificate",
    "A dashboard card with routes that are down and certificates by expiry"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "db:own",
    "network:serve",
    "network:outbound",
    "secrets:own",
    "kv:own",
    "notify:send",
    "users:impersonate",
    "ui:surface",
    "operations:provide"
  ],
  "desktop": "server",
  "contributes": {
    "tabs": [
      {
        "id": "reverse-proxy",
        "titleKey": "tab.title",
        "icon": "Waypoints",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "access",
        "titleKey": "permissions.access.title",
        "descriptionKey": "permissions.access.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "httpPort",
          "type": "number",
          "labelKey": "settings.admin.httpPort.label",
          "descriptionKey": "settings.admin.httpPort.description",
          "default": 8081,
          "min": 1,
          "max": 65535
        },
        {
          "key": "httpsPort",
          "type": "number",
          "labelKey": "settings.admin.httpsPort.label",
          "descriptionKey": "settings.admin.httpsPort.description",
          "default": 8444,
          "min": 1,
          "max": 65535
        },
        {
          "key": "bindHost",
          "type": "string",
          "labelKey": "settings.admin.bindHost.label",
          "descriptionKey": "settings.admin.bindHost.description",
          "default": "0.0.0.0"
        },
        {
          "key": "publicBaseUrl",
          "type": "string",
          "labelKey": "settings.admin.publicBaseUrl.label",
          "descriptionKey": "settings.admin.publicBaseUrl.description",
          "default": ""
        },
        {
          "key": "acmeEmail",
          "type": "string",
          "labelKey": "settings.admin.acmeEmail.label",
          "descriptionKey": "settings.admin.acmeEmail.description",
          "default": ""
        },
        {
          "key": "acmeStaging",
          "type": "boolean",
          "labelKey": "settings.admin.acmeStaging.label",
          "descriptionKey": "settings.admin.acmeStaging.description",
          "default": false
        },
        {
          "key": "acmeDirectoryUrl",
          "type": "string",
          "labelKey": "settings.admin.acmeDirectoryUrl.label",
          "descriptionKey": "settings.admin.acmeDirectoryUrl.description",
          "default": ""
        },
        {
          "key": "cookieHours",
          "type": "number",
          "labelKey": "settings.admin.cookieHours.label",
          "descriptionKey": "settings.admin.cookieHours.description",
          "default": 12,
          "min": 1,
          "max": 720
        }
      ],
      "host": {
        "enableKey": "enableReverseProxy",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": false,
        "editorGroup": "ssh",
        "fields": [
          {
            "key": "targetAddress",
            "type": "string",
            "labelKey": "settings.host.targetAddress.label",
            "descriptionKey": "settings.host.targetAddress.description",
            "requires": "enableReverseProxy",
            "defaultable": false
          },
          {
            "key": "defaultAccess",
            "type": "select",
            "labelKey": "settings.host.defaultAccess.label",
            "descriptionKey": "settings.host.defaultAccess.description",
            "requires": "enableReverseProxy",
            "default": "none",
            "options": [
              {
                "value": "none",
                "labelKey": "settings.host.defaultAccess.none"
              },
              {
                "value": "user",
                "labelKey": "settings.host.defaultAccess.user"
              },
              {
                "value": "host",
                "labelKey": "settings.host.defaultAccess.host"
              }
            ]
          }
        ]
      }
    },
    "uses": ["homepage.widgets"],
    "dashboardCards": [
      {
        "id": "reverse-proxy",
        "titleKey": "card.title",
        "icon": "Waypoints"
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "reverse-proxy.list-routes",
          "titleKey": "operations.list.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "reverse-proxy.failing",
          "titleKey": "operations.failing.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "surfaces": {
            "palette": false
          }
        },
        {
          "id": "reverse-proxy.enable-route",
          "titleKey": "operations.enable.title",
          "icon": "Play",
          "scope": "resource",
          "resource": "reverse-proxy.route",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "idempotent": true,
          "undo": "reverse-proxy.disable-route",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "reverse-proxy.disable-route",
          "titleKey": "operations.disable.title",
          "icon": "Square",
          "scope": "resource",
          "resource": "reverse-proxy.route",
          "risk": "destructive",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "idempotent": true,
          "undo": "reverse-proxy.enable-route",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        }
      ],
      "resources": [
        {
          "id": "reverse-proxy.route",
          "titleKey": "operations.routes.title",
          "icon": "Globe",
          "list": "reverse-proxy.list-routes",
          "key": "id",
          "name": "name",
          "status": "state",
          "url": "url",
          "tab": "reverse-proxy",
          "columns": [
            {
              "key": "domain",
              "titleKey": "operations.routes.domain"
            },
            {
              "key": "target",
              "titleKey": "operations.routes.target"
            },
            {
              "key": "kind",
              "titleKey": "operations.routes.kind"
            }
          ],
          "filters": ["state", "kind"]
        }
      ],
      "signals": [
        {
          "id": "reverse-proxy.failing",
          "titleKey": "operations.failing.title",
          "read": "reverse-proxy.failing",
          "scope": "host",
          "kind": "count",
          "refreshSec": 120
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
